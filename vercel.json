{
  "builds": [
    {
      "src": "app/backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "app/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app/backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "app/frontend/$1"
    }
  ]
}
