{
  "version": 2,
  "builds": [
    {
      "src": "app/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "app/backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "app/backend/main.py"
    },
    {
      "src": "/(.*)",
      "destination": "/app/frontend/dist/$1"
    }
  ]
}
